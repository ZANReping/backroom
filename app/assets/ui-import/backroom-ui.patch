+/* ========================================================================== */
+/* 2026-10 UI 优化 · 第一部分：通用交互令牌 + 标题画面                        */
+/* 全部基于主题变量（--ink/--panel/--text/--amber…），8 个主题与两种呈现自动适配 */
+/* ========================================================================== */
+:root {
+  --ui-radius: 3px;
+  --ui-focus: color-mix(in srgb, var(--amber) 85%, var(--text));
+  --ui-scrim: color-mix(in srgb, var(--ink) 86%, transparent);
+  --ui-scrim-soft: color-mix(in srgb, var(--ink) 46%, transparent);
+}
+/* 键盘可达：所有按钮/输入在键盘聚焦时有清晰描边（鼠标点击不出现） */
+button:focus-visible,
+[role='button']:focus-visible,
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid var(--ui-focus);
+  outline-offset: 2px;
+}
+
+/* ---- 标题画面：左侧档案目录 ---- */
+.title-shell {
+  position: relative;
+  display: flex;
+  height: 100%;
+  width: 100%;
+  align-items: center;
+}
+.title-scrim {
+  pointer-events: none;
+  position: absolute;
+  inset: 0;
+  background:
+    linear-gradient(90deg, var(--ui-scrim) 0, var(--ui-scrim) 24%, var(--ui-scrim-soft) 46%, transparent 68%),
+    linear-gradient(0deg, color-mix(in srgb, var(--ink) 55%, transparent), transparent 22%);
+}
+.title-col {
+  position: relative;
+  display: flex;
+  width: min(440px, 100%);
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 10px;
+  margin-left: clamp(24px, 8vw, 128px);
+  padding: 24px 0;
+}
+.title-kicker {
+  font-size: 10px;
+  letter-spacing: 0.24em;
+  color: color-mix(in srgb, var(--blood) 70%, var(--text));
+  opacity: 0.85;
+}
+.title-sub {
+  margin-top: -2px;
+  font-size: 12px;
+  letter-spacing: 0.42em;
+  color: color-mix(in srgb, var(--text) 72%, var(--text-dim));
+}
+.title-foot {
+  margin-top: 6px;
+  font-size: 11px;
+  color: color-mix(in srgb, var(--text) 55%, var(--text-dim));
+}
+.title-menu {
+  display: flex;
+  width: 100%;
+  max-width: 380px;
+  flex-direction: column;
+  gap: 6px;
+  margin-top: 14px;
+}
+.title-menu.is-slots { max-width: 560px; }
+.title-menu-sep {
+  height: 1px;
+  margin: 6px 0 4px;
+  background: linear-gradient(90deg, color-mix(in srgb, var(--panel-edge) 90%, transparent), transparent);
+}
+/* 菜单项：序号 + 标题 + 副行；悬停不再改变内边距（避免文字跳动），改为强调色左边条 + 序号点亮 */
+.title-menu-btn.menu-btn {
+  display: grid;
+  grid-template-columns: 1fr;
+  padding: 10px 14px 10px 46px;
+  border-left-width: 2px;
+  border-radius: var(--ui-radius);
+  background: color-mix(in srgb, var(--panel) 72%, transparent);
+  font-size: 15px;
+  line-height: 1.25;
+}
+.title-menu-btn.menu-btn::before { content: none; }
+.title-menu-btn.menu-btn:hover,
+.title-menu-btn.menu-btn:focus-visible {
+  padding-left: 46px;
+  transform: translateX(3px);
+  border-color: color-mix(in srgb, var(--amber) 55%, var(--panel-edge));
+  border-left-color: var(--amber);
+  background: color-mix(in srgb, var(--amber) 10%, var(--panel));
+}
+.title-menu-btn .menu-index {
+  position: absolute;
+  left: 14px;
+  top: 50%;
+  transform: translateY(-50%);
+  font-size: 11px;
+  letter-spacing: 0.06em;
+  color: var(--text-dim);
+  transition: color 0.15s;
+}
+.title-menu-btn:hover .menu-index,
+.title-menu-btn:focus-visible .menu-index { color: var(--amber); }
+.title-menu-btn .menu-label { color: inherit; }
+.title-menu-btn .menu-hint {
+  overflow: hidden;
+  margin-top: 2px;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  font-size: 11px;
+  letter-spacing: 0.02em;
+  color: var(--text-dim);
+}
+.title-menu-btn.menu-btn--primary {
+  padding-top: 13px;
+  padding-bottom: 13px;
+  border-color: color-mix(in srgb, var(--amber) 70%, var(--panel-edge));
+  border-left-color: var(--amber);
+  background: linear-gradient(90deg, color-mix(in srgb, var(--amber) 22%, var(--panel)), color-mix(in srgb, var(--panel) 80%, transparent));
+  font-size: 17px;
+  font-weight: 700;
+  color: var(--amber);
+}
+.title-menu-btn.menu-btn--primary .menu-index { color: var(--amber); }
+.title-menu-btn.menu-btn--primary .menu-hint { color: color-mix(in srgb, var(--text) 70%, var(--text-dim)); font-weight: 400; }
+/* 浅色纸面主题：主按钮改为实心强调色，保证纸面上的层级对比 */
+[data-theme='liminal'] .title-menu-btn.menu-btn--primary,
+[data-theme='basalt'] .title-menu-btn.menu-btn--primary,
+[data-theme='fandom'] .title-menu-btn.menu-btn--primary,
+[data-theme='meg'] .title-menu-btn.menu-btn--primary {
+  background: var(--amber);
+  color: var(--on-accent, var(--panel));
+  border-color: var(--amber);
+}
+[data-theme='liminal'] .title-menu-btn.menu-btn--primary .menu-index,
+[data-theme='basalt'] .title-menu-btn.menu-btn--primary .menu-index,
+[data-theme='fandom'] .title-menu-btn.menu-btn--primary .menu-index,
+[data-theme='meg'] .title-menu-btn.menu-btn--primary .menu-index,
+[data-theme='liminal'] .title-menu-btn.menu-btn--primary .menu-hint,
+[data-theme='basalt'] .title-menu-btn.menu-btn--primary .menu-hint,
+[data-theme='fandom'] .title-menu-btn.menu-btn--primary .menu-hint,
+[data-theme='meg'] .title-menu-btn.menu-btn--primary .menu-hint { color: color-mix(in srgb, var(--panel) 82%, transparent); }
+/* 暗色阈限 / 灰色阈限：猩红在深底上作文字太暗，主按钮改为实心猩红 + 亮字 */
+[data-theme='dark-liminal'] .title-menu-btn.menu-btn--primary,
+[data-theme='greyspace'] .title-menu-btn.menu-btn--primary {
+  background: linear-gradient(90deg, var(--amber), color-mix(in srgb, var(--amber) 70%, var(--panel)));
+  border-color: var(--amber);
+  color: #fff;
+}
+[data-theme='dark-liminal'] .title-menu-btn.menu-btn--primary .menu-index,
+[data-theme='greyspace'] .title-menu-btn.menu-btn--primary .menu-index,
+[data-theme='dark-liminal'] .title-menu-btn.menu-btn--primary .menu-hint,
+[data-theme='greyspace'] .title-menu-btn.menu-btn--primary .menu-hint { color: rgba(255, 255, 255, 0.78); }
+/* 纸面主题：标题区已有渐变底，不再给每行文字套「纸签」框，只保留主标题签 */
+.title-col .title-sub,
+.title-col .title-foot {
+  width: auto !important;
+  padding: 0 !important;
+  border: 0 !important;
+  background: none !important;
+  box-shadow: none !important;
+}
+/* 沉浸式呈现：保持其斜切边语言，但菜单项沿用本节的网格与副行 */
+[data-ui='immersive'] .title-menu-btn.menu-btn { padding-left: 46px !important; }
+[data-ui='immersive'] .title-menu-btn.menu-btn::before { content: none; }
+@media (max-width: 640px) {
+  .title-col { margin: 0 auto; padding: 24px 20px; align-items: stretch; }
+  .title-col > .title-hero, .title-kicker { align-self: center; text-align: center; }
+  .title-scrim { background: var(--ui-scrim-soft); }
+  .title-menu { max-width: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .title-menu-btn.menu-btn:hover { transform: none; }
+}
+
+/* ========================================================================== */
+/* 2026-10 UI 优化 · 第二部分：游戏内 HUD                                      */
+/* ========================================================================== */
+/* 状态条：满值行退后、低值行点亮；轨道用主题墨色 + 25% 刻度 */
+.hud-bar { transition: opacity 0.4s ease; }
+.hud-bar.is-full { opacity: 0.58; }
+.hud-bar-label { color: var(--text-dim); }
+.hud-bar-value { color: color-mix(in srgb, var(--text) 78%, var(--text-dim)); font-variant-numeric: tabular-nums; }
+.hud-bar.is-low .hud-bar-label,
+.hud-bar.is-low .hud-bar-value { color: var(--bar-c); font-weight: 700; }
+.hud-bar-track {
+  border-radius: 1px;
+  background:
+    color-mix(in srgb, var(--bar-c) 7%, color-mix(in srgb, var(--ink) 82%, transparent));
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bar-c) 22%, transparent);
+}
+.hud-bar-fill { box-shadow: 0 0 6px color-mix(in srgb, var(--bar-c) 45%, transparent); }
