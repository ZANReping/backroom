+          : [[0.001, 0.05], [0.2, 0.2], [0.3, 0.5], [0.26, 0.85], [0.3, 1.12], [0.27, 1.32], [0.24, 1.48], [0.15, 1.6], [0.001, H]]
+    body = new THREE.Mesh(lumpyLathe(prof, kind === 'great' ? 12 : 10, seed + 11, kind === 'starved' ? 0.12 : 0.32, 0.82), fm)
