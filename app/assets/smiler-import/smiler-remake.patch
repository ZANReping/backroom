+      og.gain.setValueAtTime(0.0001, t)
+      og.gain.exponentialRampToValueAtTime(0.025 * vol, t + 0.02)
+      og.gain.exponentialRampToValueAtTime(0.0005, t + 0.1)
+      o.connect(og).connect(pan); o.start(t); o.stop(t + 0.11)
+    }
+  }
+
