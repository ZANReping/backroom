+          if (Math.random() < 0.35) eng.msg('冰冷的手指扣住了你的脖子——喘不上气！', 'damage')
+        }
+      }
+    }
+  } else if ((s.phase === 'stalk' || s.phase === 'pounce' || s.phase === 'flank' || s.phase === 'standoff') && d < reach && e.attackCd <= 0 && zOk) {
