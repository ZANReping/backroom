+    const nT = kind === 'starved' ? 5 : kind === 'great' ? 14 : 9
+    for (let i = 0; i < nT; i++) {
+      const a = rnd() * Math.PI * 2, y = 0.3 + rnd() * (H - 0.5), r = (kind === 'great' ? 0.36 : 0.2) + rnd() * 0.1
