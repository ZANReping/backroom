+    float = 0
+  } else {
+    const H = kind === 'starved' ? 2.05 : kind === 'great' ? 1.75 : kind === 'phantom' ? 1.6 : 1.7
+    const prof: [number, number][] = kind === 'starved'
+      ? [[0.001, 0.35], [0.12, 0.45], [0.15, 0.8], [0.11, 1.15], [0.16, 1.45], [0.17, 1.62], [0.14, 1.78], [0.16, 1.9], [0.08, 2.02], [0.001, 2.05]]
+      : kind === 'phantom'
