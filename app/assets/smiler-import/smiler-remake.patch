+  // 咯咯笑（已察觉时间歇发出）
+  if (s.aware > 0 && s.giggleT <= 0 && d < 15) {
+    s.giggleT = 4 + Math.random() * 5
+    audio.smilerGiggle(Math.max(0.15, 0.8 * (1 - d / 15)), s.kind === 'great' ? 0.6 : s.kind === 'phantom' ? 1.5 : s.kind === 'starved' ? 1.25 : 1)
