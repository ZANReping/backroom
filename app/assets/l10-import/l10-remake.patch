+  // L7：阴天灰蓝海
+  sea: { body: '#0d303d', sky: '#5d7683', horizon: '#7d929b', absorb: [.45, .2, .14], reflect: .7, slope: 1.6, scale: 1, swell: .15, sheen: .2, glint: 1.3, foamWidth: .35, foam: .45, rain: true },
