+  vWD = aDepth;
+  ${hi && P.swell > 0 ? `
+  // Gerstner 风格的三向起伏，按水深在 0~0.6m 内衰减（水不漫出岸线）
+  float t = uWaterTime, sw = ${f(P.swell)} * (0.6 + uWaterWind * 0.8) * smoothstep(0.0, 0.6, aDepth);
