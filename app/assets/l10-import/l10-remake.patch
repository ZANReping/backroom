+  pool: { body: '#0c2733', sky: '#26333a', horizon: '#33424a', absorb: [.5, .16, .1], reflect: .4, slope: .7, scale: .7, swell: .006, sheen: .1, glint: .5, foamWidth: 0, foam: 0, rain: false },
