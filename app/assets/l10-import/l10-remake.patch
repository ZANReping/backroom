+}
+
+// ---------------------------------------------------------------- 圆草捆
+function roundBale(c: Ctx, s: Structure) {
+  const h = Math.max(.9, Number(s.data?.height ?? 1.25)), rad = h / 2, len = Math.min(s.w, s.h) * .95
