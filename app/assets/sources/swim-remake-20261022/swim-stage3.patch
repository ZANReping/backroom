-  submerged = false // 头部没入水下
-  breathT = 0 // 水下屏气计时（超限微扣 HP）
-  /** [swim] 游泳三维速度/划水/撑上岸状态（engine/swim.ts） */
-  swim: SwimState = newSwimState()
