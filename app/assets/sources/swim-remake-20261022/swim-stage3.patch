-  listeners: ((e: HudEvent) => void)[] = []
-  difficulty: Difficulty = 'normal'
-  seed = 1
-  noise = 0 // 当前噪音值 0-1（HUD 显示）
-  playerNoiseT = 0 // 玩家噪音残余时间（>0 = 正在/刚刚制造噪音；猎犬威慑判定，noiseEvent 刷新）
-  camShake = 0
-  time = 0
-  paused = false
-  over = false
-  victory = false
