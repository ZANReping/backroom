+      s.bendsSev = Math.max(s.bendsSev, sev)
+      s.bendsT = Math.max(s.bendsT, SWIM.BENDS_BASE_T + sev * SWIM.BENDS_EXTRA_T)
+      eng.msg('关节里像灌进了碎玻璃——减压病。潜回 15 米以下能缓一缓。', 'damage')
+    }
