+  // applyView 旋转的逆变换（R^-1 = R^T）
+  private unwindInput() {
+    const i = this.input
+    if (Math.abs(i.mx) < 1e-6 && Math.abs(i.my) < 1e-6) return
+    const s = Math.sin(look.yaw), c = Math.cos(look.yaw)
+    const mx = c * i.mx - s * i.my
+    const my = s * i.mx + c * i.my
+    i.mx = mx; i.my = my
+  }
