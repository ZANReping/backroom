+  entryK: number
+  sinceMsg: number
+  /** ---- 阶段 3 ---- */
+  /** 外部水流速度（涌浪 / 水墙），单独积分，不受游速上限影响 */
+  cx: number; cy: number
+  /** 已提示到的水压阶段（PRESS_DEPTHS 的下标 +1；0 = 没提示过） */
+  pressStage: number
+  /** 最近潜到的最深处（米，浅水时慢慢回落） */
+  deepMax: number
+  /** 「快速上浮」累计米数 */
+  fastUp: number
+  fastWarned: boolean
+  /** 减压病剩余时长与严重度（0–1） */
