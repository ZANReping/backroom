+  O2_URGE: 0.6,
+  O2_CONTRACT: 0.85,
+  /** 超过屏气上限后多少秒视野完全变黑 */
+  BLACKOUT_T: 6,
+  /** 出水恢复：前 RECOVER_FAST_T 秒以 RECOVER_FAST 倍速恢复，之后 RECOVER 倍速 */
+  RECOVER_FAST: 6,
+  RECOVER_FAST_T: 2,
+  RECOVER: 3,
+  /** 出水时憋气程度超过这个比例会大口吸气 */
+  GASP_K: 0.4,
+  // ---- 阶段 3：噪音分级（noiseEvent 半径，米） ----
+  /** 普通游（每游 0.9m 一次）：水下 / 水面 */
+  NOISE_SWIM_SUB: 3,
+  NOISE_SWIM_SURF: 5,
+  /** 冲刺划水（每划一下，算明显响动）：水下 / 水面拍水 */
+  NOISE_STROKE_SUB: 8,
+  NOISE_STROKE_SURF: 11,
+  /** 翻身入水 / 撑上岸 */
+  NOISE_DUCK: 6,
+  NOISE_CLIMB: 5,
+  // ---- 阶段 3：水下战斗 ----
+  /** 头没在水下时近战间隔倍率 */
+  MELEE_SLOW: 1.3,
+  /** 水下投掷：出手速度倍率、水阻（1/s）、下沉加速度。水平射程约为岸上的一半 */
+  THROW_SPEED: 0.6,
+  THROW_DRAG: 2.0,
+  THROW_G: 2.45,
+  // ---- 阶段 3：L7 水流 ----
+  /** 水流速度的衰减（1/s）：浪过去后还会被带着漂一段 */
+  CUR_DRAG: 0.9,
+  /** 涌浪推力：加速度 = 浪高 × SURGE_ACC × exp(−深度 / SURGE_DEPTH) */
+  SURGE_ACC: 2.4,
+  SURGE_DEPTH: 4,
+  /** 水墙内朝中面的拉力（m/s² × 偏离量） */
+  WALL_ACC: 1.2,
+  // ---- 阶段 3：水压 / 减压病（只在 L7） ----
+  /** 水压提示的深度（米）；150m 起扣血是原有逻辑 */
+  PRESS_DEPTHS: [30, 60, 100, 150] as readonly number[],
+  /** 超过这个上浮速度算「上浮太快」（m/s） */
+  ASCENT_FAST: 1.6,
+  /** 只有最近潜到过这么深才会累积 */
+  BENDS_MIN_DEPTH: 40,
+  /** 慢慢上浮 / 停留时「快速上浮米数」的消退速度（m/s，相当于减压停留） */
+  BENDS_DECAY: 0.5,
+  /** 回到这么浅时结算：快速上浮超过 BENDS_SAFE 米就发作 */
+  BENDS_CHECK_DEPTH: 8,
+  BENDS_SAFE: 25,
+  /** 快速上浮超过 BENDS_SAFE 后，再多 BENDS_FULL 米就是最重 */
+  BENDS_FULL: 40,
+  /** 发作时长 = BASE + 严重度 × EXTRA（秒）；关节痛扣血 = DMG0 + 严重度 × DMG1（每秒） */
+  BENDS_BASE_T: 30,
+  BENDS_EXTRA_T: 30,
+  BENDS_DMG0: 0.15,
+  BENDS_DMG1: 0.25,
+  /** 发作期间体力恢复倍率 */
+  BENDS_STAMINA: 0.5,
+  /** 潜回这么深可以「再加压」，症状消退快 3 倍 */
+  BENDS_RECOMP_DEPTH: 15,
+} as const
+
+export interface SwimState {
+  vx: number; vy: number; vz: number
+  /** 下一次划水的倒计时；<0 表示没在冲刺 */
+  strokeT: number
+  /** 划水次数（渲染层用于手臂动画相位） */
+  strokes: number
+  /** 最近一次划水后的时间（秒） */
+  sinceStroke: number
+  /** 当前划水发力剩余时间与方向 */
+  pushT: number; px: number; py: number; pz: number
+  duckCd: number
+  prevCrouch: boolean
+  /** 本帧是否贴着水面 */
+  atSurface: boolean
+  /** 撑上岸演出 */
+  out: { t: number; sx: number; sy: number; sz: number; tx: number; ty: number; tz: number } | null
+  /** 上一帧世界坐标（检测传送：位置突变就清掉惯性） */
+  lx: number; ly: number; lz: number
+  /** 想游却被挡住的持续时间（L7 用于自动翻越障碍） */
+  stuckT: number
+  /** ---- 屏气反馈（渲染层/HUD 读取） ---- */
+  /** 憋气程度 = breathT / 上限（>1 = 缺氧） */
+  o2k: number
+  /** 0 正常 / 1 憋气感 / 2 胸口抽动 / 3 缺氧 */
+  stage: 0 | 1 | 2 | 3
+  /** 缺氧黑屏程度 0–1 */
+  blackK: number
+  /** 心跳计时、最近一次心跳后的时间（HUD 脉冲） */
+  beatT: number; sinceBeat: number
+  /** 胸口抽动计时、最近一次抽动后的时间 */
+  contractT: number; sinceContract: number
+  /** 出水后经过的时间 */
+  airT: number
