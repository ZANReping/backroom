+    if (l4InteriorAt(seed, x, y0 - 1) && l4InteriorAt(seed, x - 1, y0 - 1) && l4InteriorAt(seed, x + 1, y0 - 1)) win(x, y0, 0, t, `${i}:${j}:s:${Math.floor((x - ix0) / 4)}`)
+  }
