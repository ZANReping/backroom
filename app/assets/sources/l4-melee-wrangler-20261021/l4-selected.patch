+        sky+=1.25*ce*(.3+.7*cs)/(d2+1.5)*(1-Math.min(1,d/SKY_RANGE))
+      }
+    }
+    // Carpet → ceiling/wall bounce, plus a soft ambient floor so no surface goes black.
+    const up=ny<-.5?.24:ny>.5?.5:.75
+    const ind=bounce*.42*up+halo+.025
+    r+=ind;g=r;b=r
