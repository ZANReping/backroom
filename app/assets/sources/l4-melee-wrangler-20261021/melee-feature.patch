+/** 一次近战结算（空手/旧路径立即调用；五把近战武器在前摇结束时由 engine/melee.ts 调用）。 */
+export function strike(eng: Engine, dmgIn: number, melee?: MeleeStrike): { hit: boolean; wall: boolean } {
