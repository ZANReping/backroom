+  for (const side of [-1, 1]) {
+    const op = new THREE.Group(); op.name = 'opercle'
+    op.position.set(0.75, -0.25, side * 1.18); op.rotation.y = side > 0 ? 0 : Math.PI
+    const plate = sweep([V(0.55, 0.85, 0), V(0.1, 0.2, 0.08), V(0.2, -0.65, 0.05), V(0.9, -0.95, 0)], (t, d) => (0.42 - Math.abs(t - 0.5) * 0.3) * (Math.abs(d.z) > 0.5 ? 0.18 : 1), { radial: 8, seg: 10, shade: () => 0.6 })
