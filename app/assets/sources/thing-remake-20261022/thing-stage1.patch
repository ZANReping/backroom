+
+// ---------------- 组装 ----------------
+/** 七层之物完整模型。返回的 group：userData.parts 含 head / jaw / lure / eyeL·R / gillL·R / seg{i} / fin{i}* / gill{i}*。 */
+export function buildThingMesh(): THREE.Group {
+  const M = mats()
+  const grp = new THREE.Group(); grp.name = 'thething'
+  const parts: Record<string, THREE.Object3D> = {}
+  const head = buildHead(parts)
+  grp.add(head); parts.head = head
+  // 头颈过渡：一段短管把颅后接到 seg0
+  for (let i = 0; i < THING.segs; i++) {
+    const R = rng(0x5e9 + i * 101)
+    const seg = new THREE.Group(); seg.name = `seg${i}`
+    seg.position.set(-i * THING.spacing - 0.1, 0, 0)
+    const glitch = THING.glitchSegs.includes(i)
+    if (glitch) {
+      // 断口：本节在 40% 处断开（两截各自封口、露出切面），中间空 0.7m——动画层会让两截错位漂浮
+      const cut = -THING.spacing * 0.4
+      const a = new THREE.Mesh(segmentTube(i, 0.15, cut + 0.35, false, true), M.skin)
+      const b = new THREE.Group(); b.name = `seg${i}b`
+      const bm = new THREE.Mesh(segmentTube(i, cut - 0.35, -THING.spacing - 0.15, true, false), M.skin)
+      b.add(bm)
+      const f1 = cutFace(thingRadius(i, 0.4)); f1.position.x = cut + 0.36; f1.rotation.y = -Math.PI / 2
+      const f2 = cutFace(thingRadius(i, 0.4)); f2.position.x = cut - 0.36
