diff --git a/app/scripts/check-l7-cliffs.ts b/app/scripts/check-l7-cliffs.ts
new file mode 100644
index 0000000..d998843
--- /dev/null
+++ b/app/scripts/check-l7-cliffs.ts
@@ -0,0 +1,87 @@
+/* eslint-disable @typescript-eslint/no-explicit-any -- 验收脚本直接拨动引擎内部字段 */
+// [thing] L7 陡崖防卡死验收：在入口海山崖壁与远海陡坡上逐点放置玩家（贴着海床），
+// 比较旧判定（无出发点）与新判定（海床「不变差就放行」）下 8 个方向是否都走不动。运行：npm run check:l7-cliffs
+import { createCanvas } from '@napi-rs/canvas'
+const memory = new Map<string, string>()
+Object.assign(globalThis, {
+  document: { createElement: () => createCanvas(256, 256) },
+  window: { addEventListener() {}, removeEventListener() {}, matchMedia: () => ({ matches: false }) },
+  localStorage: { getItem: (k: string) => memory.get(k) ?? null, setItem: (k: string, v: string) => memory.set(k, v), removeItem: (k: string) => memory.delete(k) },
+})
+const { Engine } = await import('../src/game/engine')
+const { audio } = await import('../src/game/core/audio')
+const { canOccupy, moveStep } = await import('../src/game/core/player')
+const { floorHeight } = await import('../src/game/world/mapgen')
+const L7 = await import('../src/game/world/infiniteL7')
+for (const k of Object.keys(audio)) if (typeof (audio as any)[k] === 'function') (audio as any)[k] = () => {}
+
+let fails = 0, n = 0
+const ok = (c: unknown, m: string) => { n++; console.log(`${c ? '✔' : '✘'} ${m}`); if (!c) fails++ }
+const DIRS = Array.from({ length: 8 }, (_, i) => [Math.cos(i * Math.PI / 4), Math.sin(i * Math.PI / 4)])
+
+for (const seed of [1, 777, 12345, 20261009]) {
+  const eng: any = new Engine(); eng.seed = seed; eng.emit = () => {}; eng.persist = () => {}
+  eng.loadLevel(7, { mapSeed: seed, firstVisit: false })
+  const m = eng.map
+  let pts = 0, oldTrap = 0, newTrap = 0, steep = 0
+  const basins: { x: number; y: number }[] = []
+  const O = L7.L7_ORIGIN
+  for (let a = 0; a < 96; a++) for (let rr = 0; rr < 14; rr++) {
+    const ang = a / 96 * Math.PI * 2, r = L7.L7_MOUNT.edge - 6 + rr * 2.6
+    const x = O.x + Math.cos(ang) * r - m.inf.ox + 0.37, y = O.y + Math.sin(ang) * r - m.inf.oy + 0.21
+    const tx = Math.floor(x), ty = Math.floor(y)
+    if (tx < 2 || ty < 2 || tx >= m.w - 2 || ty >= m.h - 2 || m.liquid[ty * m.w + tx] !== 1 || m.up[ty * m.w + tx] === 1) continue
+    const z = floorHeight(m, x, y, 0)
+    const g = Math.max(...DIRS.map(([dx, dy]) => floorHeight(m, x + dx * 0.32, y + dy * 0.32, 0) - z))
+    if (g > 0.65) steep++
+    pts++
+    const opts = { z, band: 0 as const }
+    if (DIRS.every(([dx, dy]) => !canOccupy(m, x + dx * 0.05, y + dy * 0.05, 0.32, opts))) oldTrap++
+    if (DIRS.every(([dx, dy]) => { const p = { x, y }; const d = moveStep(m, p, dx * 0.05, dy * 0.05, 0.32, opts); return !d.x && !d.y })) { newTrap++; basins.push({ x: x + m.inf.ox, y: y + m.inf.oy }) }
+  }
+  console.log(`seed ${seed}: 崖带 ${pts} 点，陡于 STEP_UP ${steep}，旧判定困死 ${oldTrap}，新判定困死 ${newTrap}`)
+  ok(pts > 300 && steep > 50, `seed ${seed} 崖带采样有效（${pts} 点 / 陡点 ${steep}）`)
+  ok(newTrap <= pts * 0.01, `seed ${seed} 新判定：静态困点降到 1% 以内（${newTrap}/${pts}，旧 ${oldTrap}）`)
+  // 剩下的是真正的沟底凹坑（往哪走都上坡）：真实引擎里按前进，贴崖上攀会把人带出来
+  const p0 = eng.player
+  let freed = 0
+  for (const b of basins) {
+    const wx0 = b.x, wy0 = b.y
+    p0.x = wx0 - m.inf.ox; p0.y = wy0 - m.inf.oy; p0.z = floorHeight(m, p0.x, p0.y, 0); p0.vz = 0; eng.dev.god = true
+    const z0 = p0.z
+    for (let k = 0; k < 90; k++) { eng.input.mx = 1; eng.input.my = 0.3; eng.step(1 / 30) }
+    eng.input.mx = 0; eng.input.my = 0
+    if (p0.z > z0 + 2 || Math.hypot(p0.x + m.inf.ox - wx0, p0.y + m.inf.oy - wy0) > 1) freed++
+  }
+  ok(freed === basins.length, `seed ${seed} 凹坑困点只按前进 3s 都能脱出（${freed}/${basins.length}）`)
+
+  // 真实引擎：贴在崖面上，只按「前进」朝台地方向游，6s 内应沿崖壁上攀并回到台地（不按上浮键）
+  const p = eng.player
+  let climbOk = 0, tries = 0, slideOk = 0
+  for (let a = 0; a < 8; a++) {
+    const ang = a / 8 * Math.PI * 2 + 0.2
+    const r = L7.L7_MOUNT.edge + 9
+    p.x = O.x + Math.cos(ang) * r - m.inf.ox + 0.4; p.y = O.y + Math.sin(ang) * r - m.inf.oy + 0.4
+    if (m.liquid[Math.floor(p.y) * m.w + Math.floor(p.x)] !== 1) continue
+    tries++
+    p.z = floorHeight(m, p.x, p.y, 0); p.vz = 0
+    eng.dev.god = true; eng.breathT = 0
+    const z0 = p.z, wx0 = p.x + m.inf.ox, wy0 = p.y + m.inf.oy
+    // 朝台地（圆心）方向：mx/my 为世界系方向
+    const dx = O.x - m.inf.ox - p.x, dy = O.y - m.inf.oy - p.y, dl = Math.hypot(dx, dy)
+    for (let k = 0; k < 180; k++) { eng.input.mx = dx / dl; eng.input.my = dy / dl; eng.input.jump = false; eng.input.crouch = false; eng.input.sprint = false; eng.step(1 / 30) }
+    // 上攀 6m，或者翻过一道小脊后已经横向游出 5m（海床在前方又下落，人自然悬浮前进）
+    if (p.z > z0 + 6 || Math.hypot(p.x + m.inf.ox - wx0, p.y + m.inf.oy - wy0) > 5) climbOk++
+    // 回到起点贴崖，沿崖横移 2s：至少挪动 1m
+    p.x = wx0 - m.inf.ox; p.y = wy0 - m.inf.oy; p.z = floorHeight(m, p.x, p.y, 0); p.vz = 0
+    const x0 = p.x + m.inf.ox, y0 = p.y + m.inf.oy
+    for (let k = 0; k < 60; k++) { eng.input.mx = -dy / dl; eng.input.my = dx / dl; eng.step(1 / 30) }
+    const sd = Math.hypot(p.x + m.inf.ox - x0, p.y + m.inf.oy - y0)
+    if (sd > 1.0) slideOk++; else console.log(`  横移不足 seed ${seed} a${a}: ${sd.toFixed(2)}m z ${p.z.toFixed(1)} floor ${floorHeight(m, p.x, p.y, 0).toFixed(1)} 结构 ${m.structures.filter((q: any) => q.solid && Math.hypot(q.x - p.x, q.y - p.y) < 2).map((q: any) => q.kind).join(',')}`)
+    eng.input.mx = 0; eng.input.my = 0
+  }
+  ok(tries >= 4 && climbOk === tries, `seed ${seed} 贴崖只按前进：${climbOk}/${tries} 次沿崖壁上攀 >6m 或翻脊游出 >5m`)
+  ok(tries >= 4 && slideOk === tries, `seed ${seed} 贴崖横移：${slideOk}/${tries} 次 2s 内挪动 >1m（边横移边沿崖上攀）`)
+}
+console.log(`L7 cliffs: ${n - fails}/${n} passed`)
+if (fails) process.exit(1)
diff --git a/app/scripts/verify-l7-terrain.mjs b/app/scripts/verify-l7-terrain.mjs
new file mode 100644
index 0000000..4547b79
--- /dev/null
+++ b/app/scripts/verify-l7-terrain.mjs
@@ -0,0 +1,134 @@
+// [thing] L7 地形：海床三平面材质 + 陡崖防卡死的游戏内实机截图（真实应用、真实加载路径、真实引擎与渲染器）。
+// 用法：node scripts/verify-tiny-ingame.mjs [l7] [l8]      截图与结果 → reports/tiny-ingame/
+// 流程：标题页 → 写一个 L7 存档走「继续游戏」进入 → 借调试入口把玩家放到环形场台心门（世界坐标 L7_ARENA）前 →
+//   (a) 小小盘踞在门上方；(b) 真实使用动作连吹 4 声石卡祖笛（engine.useSlot + engine.step）→ 小小进入 repel，抱头退开；
+//   (d) 第一人称：持笛静止手型 + 吹奏动作中段（门上方的小小正在抱头）；
+//   再用调试入口 devJump(8) 进 L8 → 传送到乐器洞（l8InstrumentCave(seed)）→ (c) 洞厅全景、岩壁乐器近景（按渲染层真实网格位置取景）。
+// swiftshader 下每秒只有零点几到几帧：每张图前等 near-world 就绪、实体网格 visible，并按 rAF 计数预热 ≥ 40 帧。
+// 若 TINY_QA_URL 未提供且 3473 端口无服务，本脚本自己启动 vite（--port 3473 --strictPort），结束时关闭。
+// 本脚本自己启动/关闭专属 QA 浏览器（/workspace/work/.pw-libs/chromium.sh、--headless=new、独立用户目录 .cache/l7-terrain-qa、调试端口 9473）。
+import { spawn } from 'node:child_process'
+import { existsSync, mkdirSync, writeFileSync } from 'node:fs'
+const port = process.env.TINY_QA_CDP ?? '9474', out = process.env.L7T_OUT ?? 'reports/l7-terrain/'
+const vport = process.env.L7T_PORT ?? '3474'
+const base = process.env.TINY_QA_URL ?? `http://127.0.0.1:${vport}`
+const want = new Set(process.argv.slice(2).length ? process.argv.slice(2) : ['l7', 'l8'])
+const W = 1280, H = 720
+mkdirSync(out, { recursive: true })
+// 中文字体（HUD 提示）：/workspace/work/.fonts 里的 NotoSansSC，经一份最小 fontconfig 交给 Chromium
+mkdirSync('.cache', { recursive: true })
+if (!existsSync('.cache/fonts.conf')) writeFileSync('.cache/fonts.conf', '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n<fontconfig><include ignore_missing="yes">/etc/fonts/fonts.conf</include><dir>/workspace/work/.fonts</dir></fontconfig>\n')
+const up = async () => { try { return (await fetch(base + '/')).ok } catch { return false } }
+let vite = null
+if (!(await up())) {
+  vite = spawn('npx', ['vite', '--port', vport, '--strictPort', '--host', '127.0.0.1'], { stdio: 'ignore', detached: true, env: { ...process.env, L0_VERIFY: '1' } })
+  for (let i = 0; i < 240 && !(await up()); i++) await new Promise((r) => setTimeout(r, 500))
+}
+const chrome = spawn(process.env.CHROME ?? '/workspace/work/.pw-libs/chromium.sh', ['--headless=new', `--remote-debugging-port=${port}`, `--user-data-dir=${process.cwd()}/.cache/l7-terrain-qa`, '--enable-automation', '--no-first-run', '--no-default-browser-check', '--disable-gpu-sandbox', '--no-sandbox', '--enable-unsafe-swiftshader', '--use-angle=swiftshader', `--window-size=${W},${H}`, 'about:blank'], { stdio: 'ignore', env: { ...process.env, FONTCONFIG_FILE: process.env.FONTCONFIG_FILE ?? `${process.cwd()}/.cache/fonts.conf` } })
+const errors = [], result = { checks: [], shots: [], info: {} }
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+const log = (...a) => console.log(new Date().toISOString().slice(11, 19), ...a)
+try {
+  let page
+  for (let i = 0; i < 120 && !page; i++) { await sleep(250); try { page = (await (await fetch(`http://127.0.0.1:${port}/json/list`)).json()).find((p) => p.type === 'page') } catch { /* 等浏览器起来 */ } }
+  if (!page) throw Error('QA 浏览器未启动')
+  const ws = new WebSocket(page.webSocketDebuggerUrl); await new Promise((r) => ws.addEventListener('open', r, { once: true }))
+  let seq = 0; const pending = new Map()
+  ws.addEventListener('message', (e) => {
+    const r = JSON.parse(e.data)
+    if (r.method === 'Runtime.exceptionThrown') errors.push(JSON.stringify(r.params.exceptionDetails).slice(0, 600))
+    if (r.method === 'Runtime.consoleAPICalled' && r.params.type === 'error') errors.push(r.params.args?.map((a) => a.value ?? a.description).join(' ').slice(0, 600))
+    const p = pending.get(r.id); if (p) { pending.delete(r.id); r.error ? p.reject(r.error) : p.resolve(r.result) }
+  })
+  const send = (method, params = {}) => new Promise((resolve, reject) => { const id = ++seq; pending.set(id, { resolve, reject }); ws.send(JSON.stringify({ id, method, params })) })
+  const ev = async (expression) => { const r = await send('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true }); if (r.exceptionDetails) throw Error(JSON.stringify(r.exceptionDetails).slice(0, 900)); return r.result?.value }
+  const until = async (expr, label, tries = 900) => { for (let i = 0; i < tries; i++) { if (await ev(`Boolean(${expr})`).catch(() => false)) return; await sleep(250) } throw Error('超时：' + label) }
+  const shot = async (name) => { writeFileSync(out + name + '.png', Buffer.from((await send('Page.captureScreenshot', { format: 'png' })).data, 'base64')); result.shots.push(out + name + '.png'); log('📷', name) }
+  const check = (ok, label) => { result.checks.push(`${ok ? '✔' : '✘'} ${label}`); log(`${ok ? '✔' : '✘'} ${label}`) }
+  await send('Runtime.enable'); await send('Page.enable')
+  const ver = await send('Browser.getVersion'), cl = await send('Browser.getBrowserCommandLine')
+  if (!ver.userAgent.includes('HeadlessChrome') || !cl.arguments.includes('--headless=new')) throw Error('不是本脚本的无头 QA 浏览器')
+  await send('Emulation.setDeviceMetricsOverride', { width: W, height: H, deviceScaleFactor: 1, mobile: false })
+  const init = await send('Page.addScriptToEvaluateOnNewDocument', { source: `localStorage.clear();sessionStorage.clear();localStorage.setItem('br_settings',JSON.stringify({renderResolution:'native',renderScale:100,maxPixelRatio:1,dynamicRes:false,lightMode:'realistic',sceneLightLimit:8,shadowQuality:0,lightShadows:0,loadingBudgetMs:6,devMode:true}))` })
+  await send('Page.navigate', { url: base + '/' })
+  await until('window.__engine && document.querySelector(".title-menu")', '标题页')
+  await send('Page.removeScriptToEvaluateOnNewDocument', { identifier: init.identifier })
+  log('标题页就绪')
+  // 写一个 L7 存档，走「继续游戏」进入（真实加载路径）
+  await ev(`(()=>{const raw=__engine.snapshot();localStorage.setItem('br_save_slot1',JSON.stringify({...raw,seed:720,level:7,mapSeed:720,savedAt:Date.now(),player:{...raw.player,level:7}}))})()`)
+  await send('Page.reload')
+  await until(`document.querySelector('canvas[data-title-level="7"][data-title-ready=true]')`, 'L7 存档标题')
+  const click = (sel, text) => ev(`(()=>{const b=[...document.querySelectorAll(${JSON.stringify(sel)})].find(b=>b.textContent.includes(${JSON.stringify(text)}));if(!b)throw Error('缺按钮 '+${JSON.stringify(text)});b.click()})()`)
+  await click('.menu-btn', '继续游戏'); await sleep(300); await click('.hud-panel button', '继续')
+  const playable = (lv) => `__engine.player.level===${lv} && !__engine.paused && !__engine.transition && !document.querySelector("[data-cutscene]") && __renderer.isNearWorldReady(__engine)`
+  await until(playable(7), 'L7 可玩', 1200)
+  check(true, '进入 L7（读档继续游戏）')
+  // 页面侧工具：rAF 帧计数、固定玩家位置/视角（主循环的游泳浮力不会把镜头带走）、钉住小小的抱头 recoil
+  await ev(`(()=>{window.__fc=0;window.__pin=null;window.__holdRecoil=null;(function f(){__fc++;const e=__engine,p=e.player,q=__pin;if(q){const m=e.map;p.x=q.wx-(m.inf?.ox??0);p.y=q.wy-(m.inf?.oy??0);p.z=q.z;p.vz=0;__look.yaw=q.yaw;__look.pitch=q.pitch;e.particles=e.particles.filter(o=>Math.hypot(o.x-p.x,o.y-p.y)>2.5)}
+    if(__holdRecoil!==null){for(const [id,g] of __renderer.entityMeshes){const sm=g.userData.tinySm;if(sm&&id===__holdRecoil)sm.recoilT=Math.max(sm.recoilT,1.0)}}requestAnimationFrame(f)})()})()`)
+  // swiftshader 下 L8 体积洞穴一块 chunk 要好几秒：放宽每帧建网格预算（默认 3/6ms，设置里最多 6/8ms）
+  await ev(`(()=>{__renderer.chunkBudgetMs=60;__renderer.loadingBudgetMs=60})()`)
