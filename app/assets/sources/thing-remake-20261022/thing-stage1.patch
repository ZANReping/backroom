+  const lure = new THREE.Mesh(new THREE.SphereGeometry(0.17, 14, 10), M.lure); lure.position.copy(barbelPts[4]); lure.scale.set(1, 1.3, 1)
+  jaw.add(lure); parts.lure = lure
+  const fil: THREE.BufferGeometry[] = []
+  for (let k = 0; k < 6; k++) { const a = k / 6 * 6.28; const p = barbelPts[4]; fil.push(sweep([p.clone(), V(p.x + Math.cos(a) * 0.15, p.y - 0.25, p.z + Math.sin(a) * 0.15), V(p.x + Math.cos(a) * 0.3, p.y - 0.55 - R() * 0.3, p.z + Math.sin(a) * 0.3)], () => 0.012, { radial: 4, seg: 5 })) }
+  jaw.add(new THREE.Mesh(merge(fil), M.barbel))
+
+  // 眼：浑浊的大眼（深色玻璃体 + 一层乳白翳），眼眶骨环；眼后下方一枚乳白发光器
+  for (const side of [-1, 1]) {
+    const socket = new THREE.Mesh(new THREE.TorusGeometry(0.47, 0.11, 8, 22), M.head)
+    socket.position.set(3.15, 0.32, side * 0.66); socket.rotation.y = side * 0.32; head.add(socket)
+    const eye = new THREE.Mesh(new THREE.SphereGeometry(0.44, 20, 14), M.eye)
+    eye.position.set(3.12, 0.32, side * 0.6); eye.scale.set(1, 1, 0.62); head.add(eye)
+    const film = new THREE.Mesh(new THREE.SphereGeometry(0.45, 20, 14, 0, Math.PI * 2, 0, Math.PI * 0.42), M.eyeFilm)
+    film.position.copy(eye.position); film.scale.copy(eye.scale); film.rotation.x = side * Math.PI / 2; head.add(film)
+    const glint = new THREE.Mesh(new THREE.SphereGeometry(0.08, 8, 6), M.eyeFilm); glint.position.set(3.32, 0.47, side * 0.86); head.add(glint)
+    const ph = new THREE.Mesh(new THREE.SphereGeometry(0.3, 14, 8), M.photophore)
+    ph.position.set(2.5, 0.06, side * 0.98); ph.scale.set(1.25, 0.45, 0.28); ph.rotation.y = side * 0.25; head.add(ph)
