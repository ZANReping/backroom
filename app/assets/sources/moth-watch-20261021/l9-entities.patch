+    await send('Page.navigate', { url: base + path })
+    let ok = false
+    for (let i = 0; i < 300 && !ok; i++) { await new Promise((r) => setTimeout(r, 200)); ok = !!(await ev(`location.href===${JSON.stringify(base + path)} && window.__ready===true`)) }
