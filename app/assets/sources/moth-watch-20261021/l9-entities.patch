+      col: (k) => mixc(hex('#c2353a'), hex('#8e2228'), 0.5 + 0.5 * Math.sin(k * 0.7 + i)), w: (k) => wOf(k / n),
+    })
+    acc.add(G_FLESH, main.part)
+    // 缠绕股：两股螺旋
+    for (const [ofs, colA, rad] of [[0, '#5e141c', 0.016], [Math.PI, '#d8b4a8', 0.011]] as [number, string, number][]) {
