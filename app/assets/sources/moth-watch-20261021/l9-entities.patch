+// 邻里守望 + 残缺者重制：无头 Chromium 截图验收（原型页 proto-watch.html）。
+// 用法：node scripts/verify-arms.mjs [视图名...]
+// 若 WATCH_QA_URL 未提供且 3391 端口无服务，本脚本自己启动 vite（--port 3391 --strictPort），结束时关闭。
+// 本脚本自己启动/关闭专属 QA 浏览器（--headless=new、独立用户目录 .cache/watch-qa、调试端口 9388），不连接任何已有浏览器。
+// 无头 SwiftShader 下 GPU 蒙皮会让 GPU 进程崩溃，所以所有视图都带 cpu=1（CPU 蒙皮替身，见 qaCpuSkin.ts）。
+import { spawn } from 'node:child_process'
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+const port = process.env.WATCH_QA_CDP ?? '9391', out = 'reports/watch/'
+let base = process.env.WATCH_QA_URL ?? 'http://127.0.0.1:3391'
+mkdirSync(out, { recursive: true })
+const P = (q, w = 1280, h = 900) => ['/proto-watch.html?cpu=1&' + q, w, h]
+const VIEWS = {
+  'lineup': P('mode=lineup', 1500, 800),
+  'lineup-real': P('mode=lineup&real=1', 1500, 800),
+  'watcher': P('mode=watcher'),
+  'watcher-real': P('mode=watcher&real=1'),
+  'eye': P('mode=eye'),
+  'eye-real': P('mode=eye&real=1'),
+  'strider': P('mode=strider'),
+  'strider-real': P('mode=strider&real=1'),
+  'mangled': P('mode=mangled', 1000, 1200),
+  'mangled-real': P('mode=mangled&real=1', 1000, 1200),
+  'mangled-clear': P('mode=mangled-clear', 1400, 900),
+  'faces': P('mode=faces'),
+  'facecu': P('mode=facecu'),
+  'tentcu': P('mode=tentcu'),
+  'legcu': P('mode=legcu'),
+  'dbg4': P('mode=lineup&dbg=4', 1500, 800),
+  'raw': P('mode=raw'),
+  'raw2': P('mode=raw2&dbg=4'),
+  'parts': P('mode=parts', 1600, 800),
+  'lod': P('mode=lod', 1400, 800),
+  'faces-real': P('mode=faces&real=1'),
+}
+const want = process.argv.slice(2).length ? process.argv.slice(2) : Object.keys(VIEWS)
+const up = async () => { try { return (await fetch(base + '/proto-watch.html')).ok } catch { return false } }
+let vite = null
+if (!(await up())) {
+  vite = spawn('npx', ['vite', '--port', '3391', '--strictPort', '--host', '127.0.0.1'], { stdio: 'ignore', detached: true, env: { ...process.env, L0_VERIFY: '1' } })
+  for (let i = 0; i < 120 && !(await up()); i++) await new Promise((r) => setTimeout(r, 500))
+}
+const chrome = spawn('chromium', ['--headless=new', `--remote-debugging-port=${port}`, `--user-data-dir=${process.cwd()}/.cache/watch-qa`, '--enable-automation', '--no-first-run', '--no-default-browser-check', '--disable-gpu-sandbox', '--no-sandbox', '--enable-unsafe-swiftshader', '--use-angle=swiftshader', 'about:blank'], { stdio: 'ignore' })
+const errors = [], results = {}
+try {
+  let page
+  for (let i = 0; i < 60 && !page; i++) { await new Promise((r) => setTimeout(r, 250)); try { page = (await (await fetch(`http://127.0.0.1:${port}/json/list`)).json()).find((p) => p.type === 'page') } catch { /* 等浏览器起来 */ } }
+  if (!page) throw Error('QA 浏览器未启动')
+  const ws = new WebSocket(page.webSocketDebuggerUrl); await new Promise((r) => ws.addEventListener('open', r, { once: true }))
+  let seq = 0; const pending = new Map()
+  ws.addEventListener('message', (e) => { const r = JSON.parse(e.data); if (r.method === 'Runtime.exceptionThrown') errors.push(r.params.exceptionDetails); if (r.method === 'Runtime.consoleAPICalled' && r.params.type === 'error') errors.push(r.params.args?.map((a) => a.value ?? a.description).join(' ')); const p = pending.get(r.id); if (p) { pending.delete(r.id); r.error ? p.reject(r.error) : p.resolve(r.result) } })
+  const send = (method, params = {}) => new Promise((resolve, reject) => { const id = ++seq; pending.set(id, { resolve, reject }); ws.send(JSON.stringify({ id, method, params })) })
+  const ev = async (expression) => { const r = await send('Runtime.evaluate', { expression, returnByValue: true }); return r.result?.value }
+  await send('Runtime.enable'); await send('Page.enable')
