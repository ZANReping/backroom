+  try { chrome.kill('SIGKILL') } catch { /* 已退出 */ }
+  if (vite) { try { process.kill(-vite.pid, 'SIGTERM') } catch { /* 已退出 */ } }
+  if (errors.length) console.log('浏览器错误：', JSON.stringify(errors).slice(0, 3000))
+}
