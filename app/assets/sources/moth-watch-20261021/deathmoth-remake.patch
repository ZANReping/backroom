+  for (const s of [1, -1] as const) for (let i = 0; i < 4; i++) {
+    const n = `leg${s > 0 ? 'L' : 'R'}${i}`
+    GUARD_LEGS.push({ f: n + '_f', t: n + '_t', s: n + '_s', H: at(n + '_f'), K: at(n + '_t'), A: at(n + '_s'), F: at(n + '_e'), side: s, i })
