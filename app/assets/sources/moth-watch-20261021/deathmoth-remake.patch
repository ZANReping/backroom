+let vite = null
+if (!(await up())) {
+  vite = spawn('npx', ['vite', '--port', '3388', '--strictPort', '--host', '127.0.0.1'], { stdio: 'ignore', detached: true, env: { ...process.env, L0_VERIFY: '1' } })
