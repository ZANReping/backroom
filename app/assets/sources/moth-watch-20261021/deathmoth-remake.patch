+    return lerp(lerp(a, b, s(xf)), lerp(c, e, s(xf)), s(yf))
+  }
+  for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {
+    const hind = y >= S / 2, u = x / S, v = (y % (S / 2)) / (S / 2)
+    // 底色：锈橙 → 翅基更暗、更褐
+    const base = mixc(hex('#8c5630'), hex('#5e3820'), smooth(0.25, 0, u) * 0.8)
+    let col = base
+    // 鳞片颗粒 + 大尺度斑驳
