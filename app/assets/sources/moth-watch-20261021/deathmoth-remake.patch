+// ---------------------------------------------------------------------------
+// 禁卫级：八足解析 IK
+// ---------------------------------------------------------------------------
+interface GuardLeg { f: string; t: string; s: string; H: V3; K: V3; A: V3; F: V3; side: 1 | -1; i: number }
+let GUARD_LEGS: GuardLeg[] | null = null, GUARD_THX: V3 | null = null
+function guardLegs() {
+  if (GUARD_LEGS) return GUARD_LEGS
