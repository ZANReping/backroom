+  }
+  // 门楣上垂下的树脂丝 / 肉帘
+  for (let k = 0; k < 7; k++) {
+    const x = -w / 2 + 0.08 + R() * (w - 0.16), len = 0.12 + R() * 0.35
+    const g = new THREE.CylinderGeometry(0.006 + R() * 0.01, 0.018, len, 6, 4)
+    g.translate(x, h - len / 2, 0.03 + R() * 0.05)
+    deform(g, () => [0, C('#c9a060')])
+    geos.push(g)
+  }
