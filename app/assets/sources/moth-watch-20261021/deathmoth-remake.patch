+let base = process.env.MOTH_QA_URL ?? 'http://127.0.0.1:3388'
+mkdirSync(out, { recursive: true })
+const P = (q, w = 1280, h = 900) => ['/proto-deathmoth.html?cpu=1&' + q, w, h]
+const A = (form, clip, view = 'three', frames = 8, extra = '') => ['/proto-deathmoth.html?cpu=1&anim=1&form=' + form + '&clip=' + clip + '&view=' + view + '&frames=' + frames + extra, 4 * 420, Math.ceil(frames / 4) * 360 + 30]
+const VIEWS = {}
+for (const [f, clips] of Object.entries({ male: ['fly', 'hover', 'dive', 'bite', 'feed', 'perch', 'death'], female: ['fly', 'hover', 'dive', 'bite', 'spray', 'perch', 'lay', 'death'], guard: ['idle', 'walk', 'run', 'rear', 'stab', 'spray', 'frenzy', 'drag', 'death'], larva: ['crawl', 'chew', 'curl', 'burrow', 'death'] }))
+  for (const c of clips) VIEWS[f + '-' + c] = A(f, c, f === 'guard' && ['walk', 'run', 'drag'].includes(c) ? 'side' : 'three')
+VIEWS['male-feed-front'] = A('male', 'feed', 'front', 4); VIEWS['male-feed-side'] = A('male', 'feed', 'side', 4); VIEWS['male-dive-side'] = A('male', 'dive', 'side', 4)
+for (const [n, f, c, v] of [['g-walk', 'guard', 'walk', 'three'], ['g-stab', 'guard', 'stab', 'three'], ['g-rear', 'guard', 'rear', 'front'], ['f-fly', 'female', 'fly', 'three'], ['f-spray', 'female', 'spray', 'side'], ['m-feed', 'male', 'feed', 'three'], ['l-crawl', 'larva', 'crawl', 'three'], ['l-curl', 'larva', 'curl', 'three'], ['g-death', 'guard', 'death', 'three']]) VIEWS['gif-' + n] = A(f, c, v, 16, '&cw=400&ch=330&dur=' + ({ walk: 1.1, stab: 1.1, rear: 1.2, fly: 0.29, spray: 1.2, feed: 2.4, crawl: 1.4, curl: 0.9, death: 1.8 })[c])
+const want = process.argv.slice(2).length ? process.argv.slice(2) : Object.keys(VIEWS)
