+    }
+  }
+}
+function pushV(p: Part, q: V3, n: V3, uv: [number, number], c: RGB, w: Wt) {
+  p.pos.push(q.x, q.y, q.z); p.nor.push(n.x, n.y, n.z); p.uv.push(uv[0], uv[1]); p.col.push(c[0], c[1], c[2])
