+    g.strokeStyle = 'rgba(48,24,12,0.7)'; g.lineWidth = 2
+    g.beginPath(); g.moveTo(S * 0.3, y0 + H * 0.12); g.quadraticCurveTo(S * 0.35, y0 + H * 0.4, S * 0.29, y0 + H * 0.66); g.stroke()
