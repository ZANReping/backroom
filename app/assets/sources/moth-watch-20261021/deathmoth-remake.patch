+    deform(g, (q, n) => [(nz(q.x * 18, q.y * 18, q.z * 18) - 0.5) * r * 0.5, mix3(C('#7a3a2c'), C('#c99070'), nz(q.x * 9, q.y * 9, q.z * 9) * 0.8 + Math.max(0, n.z) * 0.2)])
