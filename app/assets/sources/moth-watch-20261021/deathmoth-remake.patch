+  for (let r = 0; r <= rows; r++) {
+    const u = r / rows, [le, te] = plan(u, s.chord)
+    for (let c = 0; c <= cols; c++) {
+      const v = c / cols, x = lerp(le, te, v)
+      const y = Math.sin(v * Math.PI) * s.chord * 0.035 * (1 - u) - u * u * s.span * 0.04 // 弦向拱起 + 展向下垂
+      const z = s.side * s.span * u
