+    const g = new THREE.SphereGeometry(r, 10, 8)
+    const off = V(Math.sign(p.x) * (p.y >= h - 1e-3 ? 0 : -1) * r * 0.3 * (0.4 + R()) , p.y >= h - 1e-3 ? -r * 0.35 : (R() - 0.5) * 0.05, r * (0.2 + R() * 0.5))
