+    if (!half) { g.fillStyle = 'rgba(236,224,200,0.8)'; g.beginPath(); g.moveTo(S * 0.86, y0 + H * 0.05); g.lineTo(S * 0.93, y0 + H * 0.1); g.lineTo(S * 0.84, y0 + H * 0.16); g.fill() }
