+    const mark = this.avenueMarks.find((mk) => mk.seq === this.avenueHintSeq)
+    if (!mark) return null
+    const x = mark.wx - m.inf.ox, y = mark.wy - m.inf.oy
+    return { x, y, d: Math.hypot(x - this.player.x, y - this.player.y), mark }
+  }
