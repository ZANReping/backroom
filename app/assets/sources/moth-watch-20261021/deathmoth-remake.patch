+/** 隐藏/恢复单颗卵（第 3 阶段打破卵用） */
+export function setEggHidden(im: THREE.InstancedMesh, i: number, hidden: boolean) {
+  im.setMatrixAt(i, hidden ? ZERO : (im.userData.eggMatrices as THREE.Matrix4[])[i]); im.instanceMatrix.needsUpdate = true
