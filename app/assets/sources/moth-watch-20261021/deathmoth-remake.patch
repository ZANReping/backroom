+  ok(e.over && A.mothFx(e).gels.length > 0, '被死亡飞蛾杀死：直接死亡，原地留下胶状球')
+}
+
+mkdirSync('reports/deathmoth', { recursive: true })
+writeFileSync('reports/deathmoth/mechanics-check.txt', lines.join('\n') + `\n\ncheck:deathmoth ${n - fails}/${n}\n`)
+console.log(`check:deathmoth ${n - fails}/${n}`)
