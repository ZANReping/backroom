+}
+function hindPlan(u: number, chord: number): [number, number] {
+  const lead = chord * (0.05 + 0.18 * u - 0.15 * u * u)
+  const trail = lead - chord * (0.55 + 0.7 * Math.sin(Math.PI * Math.min(1, u * 0.95 + 0.05)) ** 0.6) * (1 - 0.85 * smooth(0.8, 1, u))
+  return [lead, trail]
+}
