+
+    // ---- 层级氛围事件（wiki 设定播报）+ L1 停电恢复（engine/ambient.ts）----
+    this.updateAmbient(dt)
+
+    // ---- 视野 ----
+    this.computeVisibility()
+
+    this.camShake = Math.max(0, this.camShake - dt * 2.2)
+  }
