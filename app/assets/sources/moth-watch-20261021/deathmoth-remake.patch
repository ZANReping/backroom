+  u.normalize()
+  for (let i = 0; i <= n; i++) {
+    if (i > 0) { const ax = V(0, 0, 0).crossVectors(T[i - 1], T[i]); const s = ax.length(); if (s > 1e-6) u.applyAxisAngle(ax.normalize(), Math.atan2(s, T[i - 1].dot(T[i]))) }
