+    q.setFromEuler(new THREE.Euler(R() * 6, R() * 6, R() * 6))
+    const s = 0.5 + R() * 0.6
+    mat.compose(V((R() - 0.5) * r, r * 0.9 + (R() - 0.5) * r, (R() - 0.5) * r), q, V(s, s, s)); bones.setMatrixAt(k, mat)
+  }
+  grp.add(bones, shell)
+  grp.userData.nestProp = 'gelball'
+  return grp
+}
