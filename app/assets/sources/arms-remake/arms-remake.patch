+}
+
+mkdirSync('reports/arms', { recursive: true })
+lines.push('', `${n - fails}/${n} 通过`)
+writeFileSync('reports/arms/mechanics-check.txt', lines.join('\n') + '\n')
+console.log(`\n${n - fails}/${n} 通过`)
+if (fails) process.exit(1)
