+  for (let k = 0; k < 8; k++) {
+    const a = ((k + salt) % 8) / 8 * Math.PI * 2, dx = Math.cos(a), dy = Math.sin(a)
+    const lx = p.x + dx * ARMS.spitPushOut, ly = p.y + dy * ARMS.spitPushOut
+    if (armsLandingOk(eng, lx, ly, v.floorZ, p.x, p.y)) return { dx, dy }
+  }
+  return null
+}
