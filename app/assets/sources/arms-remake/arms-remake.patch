+export function armsVent(g: THREE.Object3D): ArmsVent | null { return (g.userData.armsVent as ArmsVent) ?? null }
+/** 格栅开合：0 = 关闭（与管口平齐），1 = 完全打开（向下垂挂约 95°） */
+export function setGrateOpen(vent: THREE.Object3D, t: number) {
