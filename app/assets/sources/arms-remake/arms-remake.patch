+  let roof = ceilingHeightAt(m, x, y, wh, band)
+  if (!Number.isFinite(roof) || roof - floorZ < 2.2 || roof - floorZ > 12) roof = floorZ + wh
+  // 挑高处：风口吊在 ventHangH，吊管通到真正的天花板；管内路径一路竖直穿过吊管，到天花板以上才转水平
