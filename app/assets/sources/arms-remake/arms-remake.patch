+const boxAt = (w: number, h: number, d: number, x: number, y: number, z: number, c: RGB, rx = 0, uvs = 1) => {
+  const g = new THREE.BoxGeometry(w, h, d); if (rx) g.rotateX(rx); g.translate(x, y, z); return colored(g, c, uvs)
