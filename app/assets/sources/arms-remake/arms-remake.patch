+  const R2 = swallowFlow(1601, 100, (e2: any, spot: any) => {
+    const sp = openSpot(e2, 2.5, { x: spot.x, y: spot.y, r: 18 })
+    const d = Math.hypot(sp.x - spot.x, sp.y - spot.y)
