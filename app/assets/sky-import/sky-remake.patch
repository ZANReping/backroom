+  float mu = dot(rd, uSunDir);
+  float phase = mix(hg(mu, 0.5), hg(mu, -0.2), 0.3) * 4.0 * PI;
+  for (int i = 0; i < ${steps}; i++) {
+    vec3 p = ro + rd * t;
