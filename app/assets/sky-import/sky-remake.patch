+    out.push([...buf].map(h => THREE.DataUtils.fromHalfFloat(h)))
+  }
+  return out
+}
+function loop() {
+  frame++
+  renderer.setScissorTest(false)
+  renderer.setViewport(0, 0, W, H); renderer.clear()
+  views.forEach((v, i) => {
+    if (v.sys) v.sys.update(renderer, t + frame / 60, (v.scene.fog as THREE.Fog).color)
