+  const u = ((Math.atan2(L.z, L.x) / (2 * Math.PI)) % 1 + 1) % 1
+  const vv = Math.pow((L.y + .06) / 1.06, 1 / 1.5)
+  const W2 = sys.rt.width, H2 = sys.rt.height
