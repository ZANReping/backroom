+    const prof = [[0, 0.11, 0.085], [0.12, 0.118, 0.09], [0.27, 0.082, 0.064], [0.42, 0.135, 0.1], [0.62, 0.165, 0.118], [0.82, 0.17, 0.1], [0.92, 0.2, 0.085], [1, 0.07, 0.055]]
