+/** 卷曲须丝：沿 dir 伸出的螺旋细管，末端越卷越紧 */
+function wisp(start: THREE.Vector3, dir: THREE.Vector3, len: number, R: () => number, thick = 0.0065) {
+  const d = dir.clone().normalize()
+  const a = Math.abs(d.y) < 0.9 ? V(0, 1, 0) : V(1, 0, 0)
