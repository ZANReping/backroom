{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@dummy",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": [],
    "ignoreDeprecations": "6.0",
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["../src/**/*.ts", "../src/**/*.tsx", "./shims.d.ts", "./three.d.ts", "./react.d.ts"]
}
