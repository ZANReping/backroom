    "check:instance-colors": "esbuild scripts/check-instance-colors.ts --bundle --platform=node --format=esm --outfile=.cache/check-instance-colors.mjs && node .cache/check-instance-colors.mjs",
    "check:texture-images": "esbuild scripts/check-texture-images.ts --bundle --platform=node --format=esm --outfile=.cache/check-texture-images.mjs && node .cache/check-texture-images.mjs",
