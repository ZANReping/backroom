    "check:career-network": "esbuild scripts/check-career-network.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=.cache/check-career-network.mjs && node .cache/check-career-network.mjs",
    "check:bntg": "esbuild scripts/check-bntg.ts --bundle --platform=node --format=esm --outfile=.cache/check-bntg.mjs && node .cache/check-bntg.mjs",
    "check:settlement-assets": "node scripts/check-settlement-assets.mjs",
    "fetch:settlement-assets": "node scripts/fetch-settlement-assets.mjs",
    "check:generation-obstacles": "esbuild scripts/check-generation-obstacles.ts --bundle --platform=node --format=esm --outfile=.cache/check-generation-obstacles.mjs && node .cache/check-generation-obstacles.mjs",
