  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-lite.mjs",
    "check:l4": "esbuild scripts/check-l4-generation.ts --bundle --platform=node --format=esm --outfile=.cache/check-l4-generation.mjs && node .cache/check-l4-generation.mjs",
    "fetch:l4-assets": "node scripts/fetch-l4-assets.mjs",
    "fetch:l5-assets": "node scripts/fetch-l5-assets.mjs",
    "generate:l10-pbr": "esbuild scripts/gen-l10-pbr.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --outfile=.cache/gen-l10-pbr.mjs && node .cache/gen-l10-pbr.mjs",
    "check:l10": "esbuild scripts/check-l10-generation.ts --bundle --platform=node --format=esm --outfile=.cache/check-l10-generation.mjs && node .cache/check-l10-generation.mjs",
    "check:l11": "esbuild scripts/check-l11-generation.ts --bundle --platform=node --format=esm --outfile=.cache/check-l11-generation.mjs && node .cache/check-l11-generation.mjs",
